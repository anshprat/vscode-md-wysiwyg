{
  "name": "md-wysiwyg",
  "displayName": "Markdown WYSIWYG",
  "description": "Edit Markdown files in a rich-text (WYSIWYG) editor with GitHub styles. Untouched blocks keep their exact Markdown, so diffs stay small.",
  "version": "1.0.0",
  "publisher": "anshprat",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/anshprat/vscode-md-wysiwyg"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "rich text",
    "editor",
    "milkdown",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdWysiwyg.editor",
        "displayName": "Markdown Rich Text",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdWysiwyg.openRichText",
        "title": "Open in Rich Text Editor",
        "category": "Markdown WYSIWYG",
        "icon": "$(edit)"
      },
      {
        "command": "mdWysiwyg.openSource",
        "title": "Open Markdown Source",
        "category": "Markdown WYSIWYG",
        "icon": "$(code)"
      },
      {
        "command": "mdWysiwyg.openSourceToSide",
        "title": "Open Markdown Source to the Side",
        "category": "Markdown WYSIWYG",
        "icon": "$(split-horizontal)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdWysiwyg.openRichText",
          "when": "editorLangId == markdown && resourceExtname =~ /^\\.(md|markdown)$/ && !isInDiffEditor && !notebookEditorFocused",
          "group": "navigation"
        },
        {
          "command": "mdWysiwyg.openSource",
          "when": "activeCustomEditorId == mdWysiwyg.editor",
          "group": "navigation"
        },
        {
          "command": "mdWysiwyg.openSourceToSide",
          "when": "activeCustomEditorId == mdWysiwyg.editor",
          "group": "1_mdWysiwyg"
        }
      ],
      "explorer/context": [
        {
          "command": "mdWysiwyg.openRichText",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "mdWysiwyg.openRichText",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/"
        },
        {
          "command": "mdWysiwyg.openSource",
          "when": "activeCustomEditorId == mdWysiwyg.editor"
        },
        {
          "command": "mdWysiwyg.openSourceToSide",
          "when": "activeCustomEditorId == mdWysiwyg.editor"
        }
      ]
    },
    "configuration": {
      "title": "Markdown WYSIWYG",
      "properties": {
        "mdWysiwyg.rememberMode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open Markdown files in the mode you used last. **Open in Rich Text Editor** makes rich text the default editor for `*.md` and `*.markdown` files (it sets `#workbench.editorAssociations#`). **Open Markdown Source** removes that default again."
        },
        "mdWysiwyg.imageFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for pasted and dropped images, relative to the Markdown file. Empty means the file's own folder. Example: `images`."
        },
        "mdWysiwyg.colors": {
          "type": "string",
          "enum": [
            "github",
            "editor"
          ],
          "enumDescriptions": [
            "GitHub's light or dark Markdown colors, following the light or dark kind of the color theme.",
            "The background and text colors of the current color theme, with GitHub's Markdown layout."
          ],
          "default": "github",
          "description": "Colors of the rich text editor."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:webview": "node scripts/build.mjs && node test/e2e/webview.mjs",
    "test:vscode": "node scripts/build.mjs && node test/e2e/vscode.mjs",
    "test:web": "node scripts/build.mjs && node test/e2e/web.mjs",
    "package": "node scripts/build.mjs && vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "github-markdown-css": "^5.9.0",
    "happy-dom": "^20.14.5",
    "mdast-util-to-string": "^4.0.0",
    "ovsx": "^0.10.1",
    "playwright": "~1.64.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.3"
  }
}
